{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": ["src/components/**", "src/pages/**", "src/hooks/**", "src/context/**", "src/types/**", "src/utils/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [{ "name": "@supabase/supabase-js", "message": "Solo src/services/ puede usar Supabase." }],
          "patterns": [{ "group": ["@/services/supabase", "@/services/supabase/*", "**/services/supabase", "**/services/supabase/*"], "message": "Solo src/services/ puede usar el cliente de Supabase." }]
        }]
      }
    },
    {
      "files": ["src/components/**", "src/pages/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [{ "name": "@supabase/supabase-js", "message": "La UI no accede a datos: usa un hook de src/hooks/." }],
          "patterns": [{ "group": ["@/services", "@/services/*", "**/services", "**/services/*"], "message": "La UI no accede a datos: usa un hook de src/hooks/." }]
        }]
      }
    }
  ]
}
